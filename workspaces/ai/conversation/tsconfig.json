{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assurance/*": ["src/assurance/*"],
      "@context/*": ["src/context/*"],
      "@contracts/*": ["src/contracts/*"],
      "@memory/*": ["src/memory/*"],
      "@ports/*": ["src/ports/*"],
      "@routing/*": ["src/routing/*"],
      "@runtime/*": ["src/runtime/*"]
    }
  },
  "include": ["src/**/*.ts"]
}

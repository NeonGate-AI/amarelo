{
  "name": "@nucleus/memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx src/assurance/evals/curation/memory-curation.eval.ts && node --import tsx src/assurance/evals/retrieval/memory-retrieval.eval.ts && node --import tsx src/assurance/evals/economics/memory-economics.eval.ts",
    "eval": "pnpm run eval:curation && pnpm run eval:retrieval && pnpm run eval:economics",
    "eval:curation": "node --import tsx src/assurance/evals/curation/memory-curation.eval.ts",
    "eval:retrieval": "node --import tsx src/assurance/evals/retrieval/memory-retrieval.eval.ts",
    "eval:economics": "node --import tsx src/assurance/evals/economics/memory-economics.eval.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "zod": "4.4.3",
    "@repo/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "@repo/evaluation": "workspace:*"
  },
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#application/*": "./src/application/*.ts",
    "#infrastructure/*": "./src/infrastructure/*.ts"
  }
}

# `VITE_*` values are browser-visible; never put API keys or other secrets here.
# `CHATTERBOX_URL` is only used by the Vite server proxy.
# Open onboarding and Mobile as localhost (not mixed with 127.0.0.1) so the
# existing HttpOnly WorkOS cookie reaches the same-origin /api proxy.
# Chatterbox must allow the exact browser Origin, normally http://localhost:3003.
# VITE_CHATTERBOX_URL must be a same-origin path; no browser API key is used.
VITE_CHATTERBOX_URL=/api
CHATTERBOX_URL=http://127.0.0.1:3004
VITE_AMARELO_TEXT_DRIVER=false
VITE_AMARELO_REALTIME_VOICE=false

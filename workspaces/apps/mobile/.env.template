# VITE_* values are browser-visible. Never add provider keys or credentials.
# Set VITE_AMARELO_REALTIME_VOICE=true to use the private local voice MVP.
# Chatterbox owns OpenAI, Neo4j, queue configuration and the local subject.
# Keep its CHATTERBOX_AUTH_MODE=local for the local MVP; WorkOS is deferred.
# Run the local services before starting Mobile. Memory permission is explicit
# in the conversation screen and must be acknowledged before microphone capture.
# Open http://localhost:3003 consistently; Chatterbox must allow this exact Origin.
# CHATTERBOX_URL is read only by the Vite server proxy, never sent to the browser.
VITE_CHATTERBOX_URL=/api
CHATTERBOX_URL=http://127.0.0.1:3004
VITE_AMARELO_TEXT_DRIVER=false
VITE_AMARELO_REALTIME_VOICE=false

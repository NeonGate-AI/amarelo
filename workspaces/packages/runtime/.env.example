# Local Kubernetes runtime configuration.
# CLI profile selection uses the shell, not this Secret input:
# AMARELO_RUNTIME_PROFILE=memory elo runtime up
# Server-only identity/provider settings; shared by onboarding and Chatterbox.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
WORKOS_COOKIE_NAME=wos-session
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3003
OPENAI_API_KEY=
AI_CONVERSATION_MODEL=
# Optional infrastructure credentials stay stable across profile switches.
POSTGRES_DB=amarelo
POSTGRES_USER=amarelo
POSTGRES_PASSWORD=replace-with-a-local-url-safe-secret
POSTGRES_PORT=5432
NEO4J_AUTH=neo4j/replace-with-a-local-url-safe-secret
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_QUEUE_PASSWORD=replace-with-a-local-url-safe-secret
REDIS_QUEUE_PORT=6379
REDIS_CACHE_PASSWORD=replace-with-a-different-local-url-safe-secret
REDIS_CACHE_PORT=6379
MINIO_ROOT_USER=amarelo-local
MINIO_ROOT_PASSWORD=replace-with-a-local-url-safe-secret
OBJECT_STORAGE_API_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
LANDING_PORT=3000
CONSOLE_PORT=3001
ONBOARDING_PORT=3002
MOBILE_PORT=3003
CHATTERBOX_PORT=3004

# Optional Memory worker; queue/cache URLs must address separate servers.
MEMORY_BACKGROUND_ENABLED=false
MEMORY_NEO4J_URI=bolt://neo4j:7687
MEMORY_NEO4J_USERNAME=neo4j
MEMORY_NEO4J_PASSWORD=replace-with-a-local-url-safe-secret
MEMORY_NEO4J_DATABASE=neo4j
MEMORY_REDIS_QUEUE_URL=redis://:replace-with-a-local-url-safe-secret@redis-queue:6379/0
MEMORY_REDIS_CACHE_URL=redis://:replace-with-a-different-local-url-safe-secret@redis-cache:6379/0
MEMORY_EXTRACTION_MODEL=
MEMORY_WORKER_CONCURRENCY=1

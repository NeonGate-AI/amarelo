# Local voice MVP. mvp:init creates .env with mode 0600 and Redis passwords.
# Fill secrets and model identifiers here. Do not copy this file into Mobile.
NODE_ENV=development
CHATTERBOX_AUTH_MODE=local
CHATTERBOX_HOST=127.0.0.1
CHATTERBOX_PORT=3004
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3003
CHATTERBOX_LOCAL_OWNER_ID=owner
CHATTERBOX_SESSION_TTL_MS=900000
# WorkOS is deferred; a stable local identity does not grant Memory consent.
OPENAI_API_KEY=
# Suggested configurable IDs: gpt-realtime-2.1-mini, marin, gpt-4o-mini-transcribe.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=
# Select an OpenAI model supporting structured extraction; billed separately.
MEMORY_EXTRACTION_MODEL=
# Optional development text driver, unused by the voice path.
AI_CONVERSATION_MODEL=
MEMORY_NEO4J_URI=
MEMORY_NEO4J_USERNAME=neo4j
MEMORY_NEO4J_PASSWORD=
# Use the explicit database name shown by the Neo4j account.
MEMORY_NEO4J_DATABASE=neo4j
CHATTERBOX_MEMORY_ENABLED=true
CHATTERBOX_MEMORY_BACKGROUND_ENABLED=true
CHATTERBOX_MEMORY_BACKGROUND_PROFILE=internal
CHATTERBOX_REALTIME_MEMORY_ENABLED=true
CHATTERBOX_MEMORY_INGEST_TIMEOUT_MS=500
CHATTERBOX_MEMORY_INGEST_MAX_PENDING=16
CHATTERBOX_MEMORY_SHADOW_ENABLED=false
CHATTERBOX_MEMORY_EXPERIMENT_ENABLED=false
MEMORY_BACKGROUND_ENABLED=true
MEMORY_WORKER_CONCURRENCY=1
# Generated only by mvp:init; do not change after mvp:infra without planned rotation.
REDIS_QUEUE_PASSWORD=
REDIS_CACHE_PASSWORD=
# The launcher derives secret URLs for the worker from these passwords.
# Queue uses 127.0.0.1:6379; physically separate Cache uses 127.0.0.1:6380.

{
  "name": "@repo/ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./tokens": {
      "default": "./dist/tokens.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./src/scripts/build-tokens.sh",
    "dev": "./src/scripts/build-tokens.sh --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2"
  }
}

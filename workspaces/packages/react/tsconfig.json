{
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@components/*": ["src/ui/*"],
      "@hooks/*": ["src/hooks/*"],
      "@shadcn/*": ["src/vendors/shadcn/*"],
      "@smoothui": ["src/vendors/smoothui/index.ts"],
      "@smoothui/*": ["src/vendors/smoothui/*"],
      "@utilities": ["src/utilities/index.ts"],
      "@utilities/*": ["src/utilities/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

# Server-only values. Keep secrets empty and supply them outside version control.
CHATTERBOX_HOST=0.0.0.0
CHATTERBOX_PORT=3004
CHATTERBOX_MODEL_TIMEOUT_MS=30000
CHATTERBOX_AUTH_TIMEOUT_MS=5000
# Explicit browser origins, no trailing slash. Keep localhost consistent with onboarding.
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3003
CHATTERBOX_SESSION_TTL_MS=900000
CHATTERBOX_MAX_SESSIONS=1000
CHATTERBOX_RATE_LIMIT_PER_MINUTE=20
CHATTERBOX_MAX_CONCURRENT_TURNS=4
# Reuse onboarding's existing AuthKit configuration; never expose these to Vite.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_NAME=wos-session
AI_CONVERSATION_MODEL=
OPENAI_API_KEY=
# Opt-in internal text validation. No voice serving or Free curation activation.
CHATTERBOX_MEMORY_ENABLED=false
# Internal text curation only. Free remains disabled even when capture is enabled.
CHATTERBOX_MEMORY_BACKGROUND_ENABLED=false
CHATTERBOX_MEMORY_BACKGROUND_PROFILE=free
# Canonical tenant-scoped subject UUIDs resolved by the authenticated server mapping.
CHATTERBOX_MEMORY_INTERNAL_SUBJECT_IDS=
# This bounds only atomic evidence/outbox ingest, never worker extraction.
CHATTERBOX_MEMORY_INGEST_TIMEOUT_MS=500
CHATTERBOX_MEMORY_INGEST_MAX_PENDING=16
# Projection-only shadow: one visible model invocation; all advancement starts on hold.
CHATTERBOX_MEMORY_SHADOW_ENABLED=false
CHATTERBOX_MEMORY_SHADOW_TIMEOUT_MS=250
CHATTERBOX_MEMORY_SHADOW_MAX_CONCURRENT=2
CHATTERBOX_MEMORY_RECENT_BUFFER_TOKENS=256
# Explicit paired workload metadata, no manufactured measurements. Empty disables shadow.
# JSON fields: fixtureVersion,timestamp,evaluatorVersion,workloadVersion,capabilityProfile,
# durationBasis,recentBufferVersion,spec009Reference. Actual model/route/instructions are bound server-side.
CHATTERBOX_MEMORY_COMPARISON_METADATA_JSON=
MEMORY_NEO4J_URI=
MEMORY_NEO4J_USERNAME=
MEMORY_NEO4J_PASSWORD=
MEMORY_NEO4J_DATABASE=

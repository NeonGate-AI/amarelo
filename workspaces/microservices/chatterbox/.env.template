# Server-only values. Keep secrets empty and supply them outside version control.
NODE_ENV=development
# Explicit single-owner localhost setup. WorkOS remains the application default
# when this value is absent; local mode is rejected outside development/test.
CHATTERBOX_AUTH_MODE=local
CHATTERBOX_HOST=127.0.0.1
CHATTERBOX_LOCAL_OWNER_ID=owner
CHATTERBOX_PORT=3004
CHATTERBOX_MODEL_TIMEOUT_MS=30000
CHATTERBOX_AUTH_TIMEOUT_MS=5000
# Explicit browser origins, no trailing slash. Keep localhost consistent with onboarding.
CHATTERBOX_ALLOWED_ORIGINS=http://localhost:3003
CHATTERBOX_SESSION_TTL_MS=900000
CHATTERBOX_MAX_SESSIONS=1000
CHATTERBOX_RATE_LIMIT_PER_MINUTE=20
CHATTERBOX_MAX_CONCURRENT_TURNS=4
# WorkOS is deferred for the local MVP. Leave these empty in local mode.
# Hosted auth later uses CHATTERBOX_AUTH_MODE=workos and onboarding's AuthKit.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_NAME=wos-session
AI_CONVERSATION_MODEL=
OPENAI_API_KEY=
# This template opts into the owner's Memory MVP; supply every Neo4j field below.
# Consent must still be granted explicitly from the conversation interface.
CHATTERBOX_MEMORY_ENABLED=true
# Extraction runs in the separately started Memory worker. Free remains disabled.
CHATTERBOX_MEMORY_BACKGROUND_ENABLED=true
CHATTERBOX_MEMORY_BACKGROUND_PROFILE=internal
# Local mode derives the owner UUID automatically; no need to fill this list.
# Preserve CHATTERBOX_LOCAL_OWNER_ID to retain the same subject across restarts.
# WorkOS mode uses canonical tenant-scoped subject UUIDs in this allowlist.
CHATTERBOX_MEMORY_INTERNAL_SUBJECT_IDS=
# This bounds only atomic evidence/outbox ingest, never worker extraction.
CHATTERBOX_MEMORY_INGEST_TIMEOUT_MS=500
CHATTERBOX_MEMORY_INGEST_MAX_PENDING=16
# Projection-only shadow: one visible model invocation; all advancement starts on hold.
CHATTERBOX_MEMORY_SHADOW_ENABLED=false
CHATTERBOX_MEMORY_SHADOW_TIMEOUT_MS=250
CHATTERBOX_MEMORY_SHADOW_MAX_CONCURRENT=2
CHATTERBOX_MEMORY_RECENT_BUFFER_TOKENS=256
# Explicit paired workload metadata, no manufactured measurements. Empty disables shadow.
# JSON fields: fixtureVersion,timestamp,evaluatorVersion,workloadVersion,capabilityProfile,
# durationBasis,recentBufferVersion,spec009Reference. Actual model/route/instructions are bound server-side.
CHATTERBOX_MEMORY_COMPARISON_METADATA_JSON=
# Internal canary/A-B remains control without verified mounted evidence. No files are synthesized.
CHATTERBOX_MEMORY_EXPERIMENT_ENABLED=false
# Absolute server paths. Atomically replacing the policy file updates killSwitch on live requests.
CHATTERBOX_MEMORY_EXPERIMENT_POLICY_FILE=
CHATTERBOX_MEMORY_EXPERIMENT_EVIDENCE_FILE=
CHATTERBOX_MEMORY_EXPERIMENT_METRICS_FILE=
CHATTERBOX_MEMORY_EVIDENCE_DIRECTORY=
# Evidence directory: <artifactId>.json contains the exact gate/metrics object WITHOUT digest.
# Its SHA-256 belongs in the gate reference/metrics input; mismatch or missing files holds control.
# The process-local canary ceiling requires one process until persistent admission is delivered.
MEMORY_NEO4J_URI=
MEMORY_NEO4J_USERNAME=
MEMORY_NEO4J_PASSWORD=
MEMORY_NEO4J_DATABASE=neo4j

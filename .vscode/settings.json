{
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,

  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "always",
    "source.organizeImports": "never"
  },
  "biome.lspBinPath": "${workspaceFolder}/node_modules/.bin/biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  "css.lint.unknownAtRules": "ignore",
  "css.lint.emptyRules": "ignore",

  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "git.ignoreLimitWarning": true,

  "flow-icons.folders.associations": {
    "ai": "aurelia",
    "agents": "robot",
    ".agents": "robot",
    "orchestration": "shader",
    "prompts": "prompts",
    "docs": "docs",
    "specs": "tasks",
    "design-system": "mock",
    "plans": "strategy",
    "console": "layout",
    "landing": "public",
    "onboarding": "path",
    "skills": "jinja",
    "react": "react-components",
    "adrs": "scripts",
    "rules": "rules",
    "memory": "activity",
    "agentic": "cline",
    "evals": "coverage",
    "knowledge": "gitbook",
    "providers": "import",
    "rag": "archive",
    "ana": "grype",
    "isa": "grype",
    "nico": "grype",
    "context": "gitbook",
    "memory-nucleus": "quasar",
    "observability": "activity",
    "ranking-evaluation": "coverage",
    "common": "internal",
    "workspaces": "sky",
    "cli": "core",
    ".audit": "benchmark",
    "evaluation": "chart",
    "packages": "plastic",
    "architecture": "project",
    "memory-sdk": "sdk",
    "runtime": "rocket",
    "product": "notification"
  },

  "flow-icons.files.associations": {
    "*.spec.md": "plist",
    "*.rule.md": "bbx",
    "*.adr.md": "coding-guidelines",
    "*.audit.sh": "license"
  },

  "todohighlight.defaultStyle": {
    "borderRadius": "2px",
    "isWholeLine": true,
    "backgroundColor": "rgba(0,0,0,.2)"
  },
  "todohighlight.keywords": [
    {
      "text": "TODOS:",
      "color": "#7FDBCA",
      "border": "1px solid #7FDBCA"
    },
    {
      "text": "FIX:",
      "color": "#FF5F56",
      "border": "1px solid #FF5F56"
    },
    {
      "text": "HACK:",
      "color": "#C678DD",
      "border": "1px solid #C678DD"
    },
    {
      "text": "NOTE:",
      "color": "#61AFEF",
      "border": "1px solid #61AFEF"
    },
    {
      "text": "SECURITY:",
      "color": "#f9d544",
      "border": "1px solid #f9d544"
    },
    {
      "text": "REFACTOR:",
      "color": "#67c94a",
      "border": "1px solid #67c94a"
    },
    {
      "text": "DEBUG:",
      "color": "#ff00b9",
      "border": "1px solid #ff00b9"
    }
  ],
  "todohighlight.include": ["**/*.gitignore"]
}

{
  "name": "amarelo",
  "private": true,
  "version": "0.1.0",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "dev": "turbo dev --filter=landing --filter=console --filter=onboarding --filter=mobile",
    "runtime": "pnpm --filter @repo/runtime start",
    "start": "turbo start --filter=landing --filter=console --filter=onboarding --filter=mobile",
    "landing": "turbo dev --filter=landing",
    "console": "turbo dev --filter=console",
    "mobile": "turbo dev --filter=mobile",
    "onboarding": "turbo dev --filter=onboarding",
    "landing-start": "turbo start --filter=landing",
    "console-start": "turbo start --filter=console",
    "mobile-start": "turbo start --filter=mobile",
    "onboarding-start": "turbo start --filter=onboarding",
    "build": "turbo run build",
    "eval:ai": "pnpm --filter @nucleus/memory --filter @repo/memory-sdk --filter @ai/knowledge run eval",
    "eval:memory": "pnpm --filter @nucleus/memory --filter @repo/memory-sdk run eval",
    "eval:memory-sdk": "pnpm --filter @repo/memory-sdk run eval",
    "eval:rag": "pnpm --filter @ai/knowledge run eval:rag",
    "check:architecture": "node tooling/checks/architecture.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check workspaces tooling",
    "format": "biome format --write --vcs-use-ignore-file=true workspaces tooling",
    "commitlint": "commitlint --edit",
    "memory:test": "pnpm --filter @nucleus/memory run test",
    "eval:memory:visible": "pnpm --filter @nucleus/memory --filter @repo/memory-sdk run eval",
    "check:memory-invariants": "node tooling/checks/memory-invariants.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@neongate-ai/neon": "^0.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc}": [
      "biome lint --write --files-ignore-unknown=true",
      "biome format --write --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}

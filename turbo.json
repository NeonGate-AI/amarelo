{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env*"],
  "globalPassThroughEnv": [
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "NODE_OPTIONS",
    "NEXT_PUBLIC_CONSOLE_URL",
    "NEXT_PUBLIC_ONBOARDING_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "AI_VOICE_MODEL",
    "AI_VOICE_NAME",
    "OPENAI_API_KEY",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_DOMAIN",
    "WORKOS_COOKIE_MAX_AGE",
    "WORKOS_COOKIE_NAME",
    "WORKOS_COOKIE_PASSWORD",
    "WORKOS_COOKIE_SAMESITE",
    "XDG_CACHE_HOME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
